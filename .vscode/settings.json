{
  // === GO CONFIGURATION ===
  "go.toolsManagement.autoUpdate": true,
  "go.useLanguageServer": true,
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "workspace",
  "go.vetOnSave": "workspace",
  "go.formatTool": "goimports",
  "go.lintFlags": [
    "--fast",
    "--enable=gofmt,golint,govet,errcheck,staticcheck,unused,gosimple,structcheck,varcheck,ineffassign,deadcode"
  ],
  
  // === TESTING ===
  "go.testFlags": ["-v", "-race", "-count=1"],
  "go.testTimeout": "30s",
  "go.coverOnSave": true,
  "go.coverageDecorator": {
    "type": "gutter",
    "coveredHighlightColor": "rgba(64,128,64,0.5)",
    "uncoveredHighlightColor": "rgba(128,64,64,0.5)"
  },
  
  // === AUTO-FORMATTING ===
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll": "explicit"
  },
  
  // === GO SPECIFIC FORMATTING ===
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 4
  },
  
  // === YAML/DOCKER ===
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  
  // === FILES & FOLDERS ===
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/vendor": true,
    "**/*.exe": true,
    "**/*.test": true
  },
  
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/vendor/**": true,
    "**/node_modules/**": true
  },
  
  // === TERMINAL ===
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.env.windows": {
    "GOPATH": "${env:USERPROFILE}\\go"
  },
  
  // === GIT ===
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  
  // === EDITOR ENHANCEMENTS ===
  "editor.rulers": [80, 120],
  "editor.renderWhitespace": "boundary",
  "editor.suggestSelection": "first",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  
  // === SPECIFIC TO YOUR PROJECT ===
  "go.gopath": "${workspaceFolder}/.go",
  "go.inferGopath": false,
  "go.buildTags": "integration",
  
  // === SECURITY ===
  "files.associations": {
    "*.env.example": "dotenv",
    ".env.local": "dotenv"
  }
}