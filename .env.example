# =============================================================================
# Global E-commerce API — Environment Variables Template
# =============================================================================
# HOW TO USE:
#   cp .env.example .env
#   Edit .env with your actual values
#
# RULES:
#   ✗ NEVER commit .env to version control (.gitignore already excludes it)
#   ✗ NEVER set real secrets in config.yaml
#   ✓ Use this file as the canonical reference for all required variables
#   ✓ In production: set variables directly in your cloud provider / CI/CD
#
# PRIORITY ORDER (highest wins):
#   1. OS environment variables (production, Docker, Kubernetes)
#   2. .env file (local development)
#   3. config/config.yaml (defaults)
# =============================================================================


# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                     # development | staging | production
APP_PORT=8080
APP_NAME=global-ecommerce-api

# Build metadata — injected automatically by Makefile via git/ldflags.
# Override manually only when building without git.
APP_VERSION=dev
APP_BUILD_DATE=unknown
APP_COMMIT_HASH=unknown


# ── Server Timeouts ───────────────────────────────────────────────────────────
# Go duration format: 15s, 1m, 2h
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=30s            # Time to drain in-flight requests on SIGTERM


# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_HOST=localhost                 # Docker Compose: use service name "postgres"
DATABASE_PORT=5432
DATABASE_USER=ecommerce_user
DATABASE_PASSWORD=ecommerce_password   # ← CHANGE THIS in production
DATABASE_NAME=ecommerce_db
DATABASE_SSL_MODE=disable              # disable | require | verify-full (production)

# Connection pool tuning — these defaults are production-safe
DATABASE_MAX_CONNS=25                  # Max open connections
DATABASE_MIN_CONNS=5                   # Min idle connections maintained
DATABASE_MAX_CONN_LIFETIME=30m         # Max time a connection stays open
DATABASE_MAX_CONN_IDLE=5m              # Max idle time before connection is closed
DATABASE_HEALTH_CHECK=1m               # Interval for background health pings


# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost                   # Docker Compose: use service name "redis"
REDIS_PORT=6379
REDIS_PASSWORD=redis_password          # ← CHANGE THIS in production
REDIS_DB=0                             # Database index (0-15)


# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong secret:
#   openssl rand -hex 32
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_ACCESS_TTL=24h                     # Access token lifetime
JWT_REFRESH_TTL=168h                   # Refresh token lifetime (7 days)


# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                         # debug | info | warn | error
LOG_FORMAT=json                        # json (production/staging) | text (development)


# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Use * for development only. In production, list exact origins:
#   CORS_ALLOWED_ORIGINS=https://app.mystore.com,https://admin.mystore.com
CORS_ALLOWED_ORIGINS=*


# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100                # Max requests per window per IP
RATE_LIMIT_WINDOW=1m                   # Time window duration


# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, verify:
#   [ ] JWT_SECRET is a random string of at least 32 characters
#   [ ] DATABASE_PASSWORD is strong and unique
#   [ ] REDIS_PASSWORD is set
#   [ ] DATABASE_SSL_MODE=require
#   [ ] LOG_FORMAT=json
#   [ ] CORS_ALLOWED_ORIGINS lists only your actual frontend domains
#   [ ] APP_ENV=production
# =============================================================================
