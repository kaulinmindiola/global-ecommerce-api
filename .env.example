# ==================================================================================== #
# DATABASE CONFIGURATION
# ==================================================================================== #

# PostgreSQL connection details
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=ecommerce_pass_dev
POSTGRES_DB=ecommerce_db
POSTGRES_SSLMODE=disable

# Database connection pool settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ==================================================================================== #
# REDIS CONFIGURATION
# ==================================================================================== #

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass_dev
REDIS_DB=0
REDIS_POOL_SIZE=10

# ==================================================================================== #
# APPLICATION CONFIGURATION
# ==================================================================================== #

# Environment: development, staging, production
APP_ENV=development

# Server configuration
APP_HOST=0.0.0.0
APP_PORT=8080

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# ==================================================================================== #
# SECURITY CONFIGURATION
# ==================================================================================== #

# JWT settings (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# API Keys (for external services)
CURRENCY_API_KEY=your-currency-api-key-here

# ==================================================================================== #
# API CONFIGURATION
# ==================================================================================== #

API_VERSION=v1
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=1m
API_TIMEOUT=30s

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token

# ==================================================================================== #
# EXTERNAL SERVICES (for future phases)
# ==================================================================================== #

# Email service (placeholder)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@ecommerce.local
SMTP_PASSWORD=change-this

# Cloud storage (placeholder)
AWS_REGION=us-east-1
AWS_BUCKET=ecommerce-assets-dev
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key