# =============================================================================
# Global E-commerce API — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to version control. It is already in .gitignore.
# =============================================================================


# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_PORT=8080                # HTTP listening port
APP_VERSION=dev              # Injected via ldflags in production builds
APP_BUILD_DATE=unknown       # Injected via ldflags in production builds
APP_COMMIT_HASH=unknown      # Injected via ldflags in production builds


# ── Server Timeouts ───────────────────────────────────────────────────────────
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=30s


# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_HOST=localhost       # Use 'postgres' inside Docker Compose
DATABASE_PORT=5432
DATABASE_USER=ecommerce_user
DATABASE_PASSWORD=ecommerce_password
DATABASE_NAME=ecommerce_db
DATABASE_SSL_MODE=disable     # Use 'require' in production

# Connection pool tuning (production-safe defaults)
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE=5m
DATABASE_HEALTH_CHECK=1m


# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost          # Use 'redis' inside Docker Compose
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0


# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=168h          # 7 days


# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                # debug | info | warn | error
LOG_FORMAT=json               # json (production) | text (development)
