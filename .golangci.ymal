version: "2"

run:
  timeout: 5m
  tests: true

linters:
  enable:
    - errcheck
    - gosimple
    - govet
    - ineffassign
    - staticcheck
    - unused
    - gofmt
    - goimports
    - misspell
    - revive
    - gosec
    - goconst
    - unconvert
    - prealloc
    - bodyclose
    - gocritic
    - nolintlint
    - stylecheck
    - typecheck
    - unparam

settings:
  errcheck:
    check-type-assertions: true

  goimports:
    local-prefixes: github.com/kaulinmindiola/global-ecommerce-api

  revive:
    rules:
      - name: exported
      - name: blank-imports
      - name: context-as-argument
      - name: error-return
      - name: error-naming

issues:
  max-issues-per-linter: 0
  max-same-issues: 0
